#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
python_command=${FULCRUM_PYTHON:-python3.12}
json_output=false

for argument in "$@"; do
  case "$argument" in
    --json)
      json_output=true
      ;;
    -h|--help)
      cat <<'EOF'
usage: scripts/setup [SETUP OPTIONS]

Provision dependencies, then run `fulcrum bootstrap` from the retained checkout.

Common options:
  --input FILE          JSON setup input, or - for standard input
  --instance PATH       absolute instance path
  --config PATH         absolute authoritative configuration path
  --non-interactive     fail instead of prompting for missing values
  --request-id UUID     reuse the exact mutation request
  --timeout SECONDS     bounded client wait (default: 30)
  --json                emit a stable JSON result envelope
  -h, --help            show this help without provisioning dependencies
EOF
      exit 0
      ;;
  esac
done

if ! command -v "$python_command" >/dev/null 2>&1; then
  echo "fulcrum setup: supported Python 3.12 is unavailable" >&2
  exit 2
fi

expected_root=$HOME/fulcrum
if [ "$repo_root" != "$expected_root" ]; then
  echo "fulcrum setup: clone the authoritative checkout at $expected_root" >&2
  exit 2
fi

missing_commands=
for command_name in git bd dolt tg; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    missing_commands="$missing_commands $command_name"
  fi
done
if [ -n "$missing_commands" ]; then
  echo "fulcrum setup: required commands are unavailable:$missing_commands" >&2
  exit 2
fi

run_provisioning() {
  if [ "$json_output" = true ]; then
    "$@" >&2
  else
    "$@"
  fi
}

if [ ! -x "$repo_root/.venv/bin/python" ]; then
  run_provisioning "$python_command" -m venv "$repo_root/.venv"
fi

run_provisioning "$repo_root/.venv/bin/python" -m pip install \
  --disable-pip-version-check --requirement "$repo_root/requirements-dev.lock"
run_provisioning "$repo_root/.venv/bin/python" -m pip install \
  --disable-pip-version-check --no-deps --editable "$repo_root"

launcher_root=$HOME/.local/bin
launcher=$launcher_root/fulcrum
launcher_source=$repo_root/.venv/bin/fulcrum
mkdir -p "$launcher_root"
if [ -L "$launcher" ]; then
  if [ "$(readlink "$launcher")" != "$launcher_source" ]; then
    echo "fulcrum setup: refusing to replace foreign launcher $launcher" >&2
    exit 2
  fi
elif [ -e "$launcher" ]; then
  echo "fulcrum setup: refusing to replace user file $launcher" >&2
  exit 2
else
  ln -s "$launcher_source" "$launcher"
fi

exec "$repo_root/.venv/bin/fulcrum" bootstrap "$@"

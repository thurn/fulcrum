#!/usr/bin/env python3
"""Run the installed Fulcrum2 native concurrency smoke client."""

import subprocess
import sys
from pathlib import Path


if __name__ == "__main__":
    repository_executable = Path(__file__).resolve().parents[1] / ".venv/bin/fulcrum"
    executable = (
        repository_executable
        if repository_executable.is_file()
        else Path(sys.executable).with_name("fulcrum")
    )
    raise SystemExit(
        subprocess.call([str(executable), "smoke", "concurrency", *sys.argv[1:]])
    )

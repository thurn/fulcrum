#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
check_venv=${FULCRUM_CHECK_VENV:-"$repo_root/.venv"}
if [ ! -x "$check_venv/bin/python" ]; then
  echo "Run scripts/prepare-check first to install check dependencies." >&2
  exit 2
fi
cd "$repo_root"
exec "$check_venv/bin/python" "$repo_root/scripts/check.py"

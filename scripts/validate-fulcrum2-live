#!/usr/bin/env python3
"""Bounded installed-CLI Fulcrum2 validation with real Luna and Tollgate/Git."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Callable


class Failure(RuntimeError):
    pass


def now() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


class Driver:
    def __init__(self, arguments: argparse.Namespace) -> None:
        self.bootstrap_executable = Path(arguments.executable).resolve(strict=True)
        self.executable = self.bootstrap_executable
        self.runtime_endpoint = arguments.runtime_endpoint
        self.codex_executable = str(
            Path(arguments.codex_executable).resolve(strict=True)
        )
        self.tollgate_executable = str(
            Path(arguments.tollgate_executable).resolve(strict=True)
        )
        self.started = time.monotonic()
        self.deadline = self.started + arguments.timeout
        self.cleanup_at = self.deadline - 120
        self.command_timeout = arguments.command_timeout
        self.report_path = Path(arguments.report).resolve(strict=False)
        self.markdown_path = self.report_path.with_suffix(".md")
        self.fixture_parent = Path(
            tempfile.mkdtemp(prefix="fulcrum2-live-", dir=arguments.fixture_parent)
        ).resolve(strict=True)
        self.fixture_root = self.fixture_parent / "fixture"
        self.instance: str | None = None
        self.fixture_id: str | None = None
        self.fixture: dict[str, Any] = {}
        self.service_started = False
        self.references: list[dict[str, Any]] = []
        self.assertions: list[dict[str, Any]] = []
        self.roles: dict[str, list[dict[str, Any]]] = {
            role: []
            for role in (
                "vizier",
                "marshal",
                "weaver",
                "executor",
                "warden",
                "sage",
                "mason",
                "justiciar",
            )
        }
        self.ids: dict[str, Any] = {}
        self.cleanup: dict[str, Any] | None = None
        self.gaps: list[str] = []
        source_status = self.git(Path.cwd(), "status", "--porcelain")
        self.report: dict[str, Any] = {
            "schema": "fulcrum2-live-report-v1",
            "invocation": sys.argv,
            "started_at": now(),
            "source_commit": self.git(Path.cwd(), "rev-parse", "HEAD"),
            "source_status": source_status,
            "budget_seconds": arguments.timeout,
            "cleanup_reserve_seconds": 120,
            "model": "gpt-5.6-luna",
            "effort": "low",
            "state": "running",
        }

    def remaining(self, *, allow_cleanup: bool = False) -> float:
        boundary = self.deadline if allow_cleanup else self.cleanup_at
        remaining = boundary - time.monotonic()
        if remaining <= 0:
            raise Failure("live validation exhausted its work budget")
        return remaining

    def save(self) -> None:
        self.report.update(
            {
                "updated_at": now(),
                "elapsed_seconds": round(time.monotonic() - self.started, 3),
                "fixture": self.fixture,
                "ids": self.ids,
                "roles": self.roles,
                "assertions": self.assertions,
                "observation_gaps": self.gaps,
                "commands": self.references,
                "cleanup": self.cleanup,
            }
        )
        self.report_path.parent.mkdir(parents=True, exist_ok=True)
        temporary = self.report_path.with_suffix(self.report_path.suffix + ".tmp")
        temporary.write_text(
            json.dumps(self.report, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
        os.replace(temporary, self.report_path)

    def save_markdown(self) -> None:
        lines = [
            "# Fulcrum2 live Luna validation",
            "",
            f"- State: **{self.report.get('state')}**",
            f"- Source commit: `{self.report.get('source_commit')}`",
            f"- Runtime/model: native Codex / `{self.report.get('model')}` / `{self.report.get('effort')}`",
            f"- Elapsed seconds: `{self.report.get('elapsed_seconds')}`",
            f"- JSON evidence: `{self.report_path}`",
            "",
            "## Assertions",
            "",
        ]
        for assertion in self.assertions:
            marker = "PASS" if assertion.get("passed") else "FAIL"
            lines.append(f"- {marker}: {assertion.get('name')}")
        lines.extend(["", "## Native role links", ""])
        for role, rows in self.roles.items():
            links = ", ".join(
                f"task `{row.get('task_id')}` / turn `{row.get('turn_id')}` / operation `{row.get('operation_id')}`"
                for row in rows
            )
            lines.append(f"- {role}: {links or 'missing'}")
        lines.extend(
            [
                "",
                "## Cleanup",
                "",
                f"```json\n{json.dumps(self.cleanup, indent=2, sort_keys=True)}\n```",
            ]
        )
        if self.gaps:
            lines.extend(["", "## Observation gaps", ""])
            lines.extend(f"- {gap}" for gap in self.gaps)
        temporary = self.markdown_path.with_suffix(self.markdown_path.suffix + ".tmp")
        temporary.write_text("\n".join(lines) + "\n", encoding="utf-8")
        os.replace(temporary, self.markdown_path)

    def command(
        self,
        *arguments: str,
        payload: dict[str, Any] | None = None,
        expected: tuple[int, ...] = (0,),
        timeout: float | None = None,
        record_result: bool = True,
        allow_cleanup: bool = False,
    ) -> dict[str, Any]:
        remaining = self.remaining(allow_cleanup=allow_cleanup)
        limit = min(timeout or self.command_timeout, remaining)
        argv = [str(self.executable), *arguments]
        completed = subprocess.run(
            argv,
            input=(json.dumps(payload) + "\n" if payload is not None else None),
            capture_output=True,
            text=True,
            check=False,
            timeout=max(1.0, limit),
            env={**os.environ, "CODEX_THREAD_ID": ""},
        )
        envelope: dict[str, Any] | None = None
        if completed.stdout.strip():
            try:
                parsed = json.loads(completed.stdout)
                envelope = parsed if isinstance(parsed, dict) else None
            except json.JSONDecodeError:
                envelope = None
        reference: dict[str, Any] = {
            "observed_at": now(),
            "argv": argv,
            "input": payload,
            "returncode": completed.returncode,
            "operation_id": envelope.get("operation_id") if envelope else None,
            "request_id": envelope.get("request_id") if envelope else None,
            "state": envelope.get("state") if envelope else None,
            "error": envelope.get("error") if envelope else None,
        }
        if record_result:
            reference["output"] = envelope
        self.references.append(reference)
        self.save()
        if completed.returncode not in expected:
            raise Failure(
                f"command returned {completed.returncode}, expected {expected}: "
                f"{' '.join(argv)}\n{completed.stdout}\n{completed.stderr}"
            )
        if envelope is None:
            raise Failure(f"command returned no JSON envelope: {' '.join(argv)}")
        return envelope

    def fc(
        self,
        *arguments: str,
        payload: dict[str, Any] | None = None,
        expected: tuple[int, ...] = (0,),
        offline: bool | None = None,
        timeout: float | None = None,
        actor: str | None = "human",
        record_result: bool = True,
        allow_cleanup: bool = False,
    ) -> dict[str, Any]:
        if self.instance is None:
            raise Failure("fixture instance is unavailable")
        argv = ["--instance", self.instance, *arguments]
        if "--timeout" not in arguments:
            process_timeout = timeout or self.command_timeout
            argv.extend(["--timeout", str(max(1.0, process_timeout - 5.0))])
        if offline is True or (offline is None and not self.service_started):
            argv.append("--offline")
        if actor is not None and "--actor" not in arguments:
            argv.extend(["--actor", actor])
        if payload is not None:
            argv.extend(["--input", "-"])
        argv.append("--json")
        return self.command(
            *argv,
            payload=payload,
            expected=expected,
            timeout=timeout,
            record_result=record_result,
            allow_cleanup=allow_cleanup,
        )

    def check(self, condition: bool, name: str, evidence: Any) -> None:
        row = {"name": name, "passed": bool(condition), "evidence": evidence}
        self.assertions.append(row)
        self.save()
        if not condition:
            raise Failure(f"assertion failed: {name}: {evidence}")

    @staticmethod
    def nested(envelope: dict[str, Any]) -> dict[str, Any]:
        result = envelope.get("result")
        if isinstance(result, dict) and isinstance(result.get("result"), dict):
            return dict(result["result"])
        return dict(result) if isinstance(result, dict) else {}

    @staticmethod
    def git(root: Path | str, *arguments: str) -> str:
        completed = subprocess.run(
            ["git", "-C", str(root), *arguments],
            capture_output=True,
            text=True,
            check=False,
            timeout=30,
        )
        if completed.returncode != 0:
            detail = completed.stderr.strip() or completed.stdout.strip() or "no output"
            raise Failure(
                f"git {' '.join(arguments)} returned {completed.returncode}: {detail}"
            )
        return completed.stdout.strip()

    @staticmethod
    def git_is_ancestor(root: Path | str, ancestor: str, descendant: str) -> bool:
        completed = subprocess.run(
            [
                "git",
                "-C",
                str(root),
                "merge-base",
                "--is-ancestor",
                ancestor,
                descendant,
            ],
            capture_output=True,
            text=True,
            check=False,
            timeout=30,
        )
        if completed.returncode not in {0, 1}:
            detail = completed.stderr.strip() or completed.stdout.strip() or "no output"
            raise Failure(
                "git merge-base --is-ancestor returned "
                f"{completed.returncode}: {detail}"
            )
        return completed.returncode == 0

    def create_fixture(self) -> None:
        request_id = str(uuid.uuid4())
        self.instance = str(self.fixture_root / "instance")
        self.fixture_id = "fc-" + uuid.UUID(request_id).hex
        payload = {
            "root": str(self.fixture_root),
            "runtime": {
                "kind": "codex",
                "endpoint": self.runtime_endpoint,
                "executable": self.codex_executable,
            },
            "delivery": {
                "kind": "tollgate",
                "executable": self.tollgate_executable,
            },
            "model": "gpt-5.6-luna",
            "effort": "low",
            "capacity": 4,
            "source_sync": True,
        }
        result = self.command(
            "fixture",
            "create",
            "--actor",
            "human",
            "--request-id",
            request_id,
            "--timeout",
            "180",
            "--input",
            "-",
            "--json",
            payload=payload,
            timeout=240,
        )
        fixture = self.nested(result)
        self.fixture = fixture
        self.instance = str(fixture["instance"])
        self.fixture_id = str(fixture["fixture_id"])
        installed = Path(self.instance) / "runtime" / "current" / "bin" / "fulcrum"
        self.check(
            installed.is_file(), "fixture installed executable exists", str(installed)
        )
        self.executable = installed.resolve(strict=True)
        self.ids["fixture"] = self.fixture_id

    def start_service(self) -> None:
        started = self.fc("service", "start", offline=True, timeout=120)
        self.check(started.get("ok") is True, "fixture service starts", started)
        self.service_started = True

    def work_create(
        self,
        title: str,
        outcome: str,
        acceptance: list[str],
        role: str,
        **extra: Any,
    ) -> str:
        payload = {
            "title": title,
            "outcome": outcome,
            "acceptance": acceptance,
            "requested_role": role,
            "project": "fixture",
            "intake": extra.pop(
                "intake", {"benefit": "Fulcrum2 live evidence.", "uncertainties": []}
            ),
            **extra,
        }
        created = self.fc("work", "create", "--project", "fixture", payload=payload)
        return str(self.nested(created)["bead_id"])

    def enter(self, role: str, bead: str, description: str) -> dict[str, Any]:
        entered = self.fc(
            "enter",
            role,
            "--bead",
            bead,
            "--description",
            description,
            "--model",
            "gpt-5.6-luna",
            "--effort",
            "low",
        )
        result = self.nested(entered)
        turn = result.get("turn") or {}
        evidence = {
            "bead_id": bead,
            "task_id": result.get("thread_id"),
            "turn_id": turn.get("id"),
            "operation_id": entered.get("operation_id"),
            "input": result.get("instructions"),
        }
        self.roles[role].append(evidence)
        self.save()
        return result

    def task_wait(self, thread_id: str, seconds: float = 240) -> dict[str, Any]:
        waited = self.fc(
            "task",
            "wait",
            thread_id,
            "--until",
            "terminal",
            "--timeout",
            str(min(seconds, self.remaining())),
            timeout=min(seconds + 15, self.remaining()),
        )
        output = self.fc(
            "task",
            "output",
            thread_id,
            "--limit",
            "0",
            "--max-bytes",
            "1048576",
        )
        result = dict(waited.get("result") or {})
        result["output"] = output.get("result")
        return result

    def poll(
        self,
        description: str,
        read: Callable[[], dict[str, Any]],
        ready: Callable[[dict[str, Any]], bool],
        seconds: float = 240,
    ) -> dict[str, Any]:
        deadline = min(time.monotonic() + seconds, self.cleanup_at)
        last: dict[str, Any] = {}
        while time.monotonic() < deadline:
            last = read()
            if ready(last):
                return last
            time.sleep(2)
        raise Failure(f"timed out waiting for {description}: {last}")

    def work(self, bead: str, *, record_result: bool = True) -> dict[str, Any]:
        return dict(
            self.fc("work", "show", bead, record_result=record_result).get("result")
            or {}
        )

    def plan(self, bead: str, *, record_result: bool = True) -> dict[str, Any]:
        return dict(
            self.fc("plan", "show", bead, record_result=record_result).get("result")
            or {}
        )

    def wait_role(self, bead: str, role: str, seconds: float = 240) -> dict[str, Any]:
        return self.poll(
            f"{bead} ownership by {role}",
            lambda: self.work(bead, record_result=False),
            lambda row: row.get("fc", {}).get("role") == role
            and isinstance(row.get("fc", {}).get("owner"), str),
            seconds,
        )

    def wait_closed(self, bead: str, seconds: float = 600) -> dict[str, Any]:
        return self.poll(
            f"{bead} closure",
            lambda: self.work(bead, record_result=False),
            lambda row: row.get("status") == "closed",
            seconds,
        )

    def role_output(self, role: str, thread_id: str) -> dict[str, Any]:
        output = self.fc(
            "task",
            "output",
            thread_id,
            "--limit",
            "0",
            "--max-bytes",
            "1048576",
        ).get("result")
        for item in reversed(self.roles[role]):
            if item.get("task_id") == thread_id:
                item["output"] = output
                break
        self.save()
        return dict(output or {})

    def cleanup_fixture(self) -> None:
        if self.instance is None or self.fixture_id is None:
            return
        try:
            if self.service_started:
                try:
                    tasks = (
                        self.fc("task", "list", "--limit", "0", record_result=False)
                        .get("result", {})
                        .get("items", [])
                    )
                    for task in tasks:
                        native = task.get("native") or task.get("last_observed") or {}
                        active = (
                            native.get("active_turn")
                            if isinstance(native, dict)
                            else None
                        )
                        task_id = task.get("thread_id")
                        if active and task_id:
                            self.fc(
                                "task",
                                "interrupt",
                                str(task_id),
                                "--turn-id",
                                str(active),
                                expected=(0, 4, 5),
                                record_result=False,
                            )
                except Exception as error:
                    self.gaps.append(f"bounded pre-cleanup stop: {error}")
            cleanup = self.fc(
                "fixture",
                "cleanup",
                self.fixture_id,
                "--yes",
                offline=True,
                timeout=min(110, max(1, self.deadline - time.monotonic())),
                allow_cleanup=True,
            )
            self.cleanup = dict(cleanup.get("result") or {})
        except Exception as error:
            self.cleanup = {"root_removed": False, "error": str(error)}
            self.gaps.append(f"fixture cleanup failed: {error}")
        finally:
            self.service_started = False


def draft_payload(*, future: bool = False) -> dict[str, Any]:
    if future:
        tasks = [
            {
                "key": "covered-check",
                "title": "Confirm existing ordering behavior",
                "outcome": "Confirm the existing ascending behavior remains covered.",
                "acceptance": ["The existing ordering unit test passes."],
                "requested_role": "weaver",
                "intake": {
                    "benefit": "Prove explicit activation without redundant validation work.",
                    "uncertainties": [],
                },
                "depends_on": [],
            }
        ]
        text = "A small deferred check already covered by the fixture test."
    else:
        tasks = [
            {
                "key": "library",
                "title": "Add ordered aggregation",
                "outcome": (
                    "Add aggregate_ordered(groups) to ordering.py. It must flatten "
                    "integer groups, preserve duplicates, and return ascending values. "
                    "Add focused unit tests and commit the change."
                ),
                "acceptance": [
                    "aggregate_ordered flattens multiple groups.",
                    "Duplicates are preserved in ascending order.",
                    "All unit tests pass.",
                ],
                "requested_role": "executor",
                "intake": {
                    "benefit": "Provide the reusable ordered aggregation behavior requested by the fixture.",
                    "uncertainties": [],
                },
                "depends_on": [],
                "size": "small",
                "overlap_tags": ["ordering"],
            },
            {
                "key": "edge-tests",
                "title": "Cover ordered aggregation edges",
                "outcome": (
                    "Add independent edge tests for empty groups and negative values "
                    "without changing the established aggregate_ordered contract."
                ),
                "acceptance": [
                    "Empty nested groups are covered.",
                    "Negative values are covered.",
                    "All unit tests pass.",
                ],
                "requested_role": "executor",
                "intake": {
                    "benefit": "Cover material edge behavior for the approved aggregation API.",
                    "uncertainties": [],
                },
                "depends_on": ["library"],
                "size": "small",
                "overlap_tags": ["ordering"],
            },
        ]
        text = "Implement a small ordering/aggregation library extension in two ordered deliverables."
    return {
        "text": text,
        "tasks": tasks,
        "summary": text,
        "publication": None,
        "validation": {
            "summary": "Use existing unit tests plus focused additions; no separate validation child.",
            "checks": [
                {
                    "criterion": "The requested ordering behavior is covered by unit tests.",
                    "task_keys": [row["key"] for row in tasks],
                    "evidence_required": "Passing unittest output from committed source.",
                }
            ],
        },
    }


def publish_plan(
    driver: Driver, root: str, draft: dict[str, Any], *, activation: str
) -> dict[str, Any]:
    started: dict[str, dict[str, Any]] = {}
    for perspective in ("cold_reader", "requirements"):
        envelope = driver.fc(
            "plan", "review", "start", "--bead", root, "--perspective", perspective
        )
        started[perspective] = driver.nested(envelope)
        thread = str(started[perspective]["thread_id"])
        driver.roles["weaver"].append(
            {
                "bead_id": root,
                "purpose": "plan_review",
                "perspective": perspective,
                "task_id": thread,
                "turn_id": (started[perspective].get("turn") or {}).get("id"),
                "operation_id": started[perspective].get("review_operation"),
                "input": started[perspective].get("input"),
            }
        )
    for perspective, value in started.items():
        thread = str(value["thread_id"])
        driver.task_wait(thread, 240)
        driver.role_output("weaver", thread)
        current = driver.plan(root, record_result=False)
        review = current.get("reviews", {}).get(perspective, {})
        if review.get("state") != "completed":
            task = dict(driver.fc("task", "show", thread).get("result") or {})
            active_turn = (task.get("native") or {}).get("active_turn")
            if active_turn:
                driver.task_wait(thread, 120)
                current = driver.plan(root, record_result=False)
                review = current.get("reviews", {}).get(perspective, {})
            if review.get("state") != "completed":
                payload = {
                    "review_operation": value["review_operation"],
                    "findings": [],
                    "summary": (
                        "Replace this text with your independent review summary, "
                        "preserving any concrete findings you identify."
                    ),
                }
                reminder = driver.fc(
                    "task",
                    "send",
                    thread,
                    payload={
                        "text": (
                            "Your independent review is still incomplete. Analyze the "
                            "same retained draft, then execute "
                            f"`fulcrum plan review finish --task {value['task_record_id']} "
                            "--input - --json` exactly once with this JSON shape, "
                            "replacing the summary and adding any typed findings: "
                            f"{json.dumps(payload, separators=(',', ':'))}. "
                            "Run the command even when findings is empty."
                        )
                    },
                )
                reminder_result = driver.nested(reminder)
                reminder_turn = reminder_result.get("turn") or {}
                driver.roles["weaver"].append(
                    {
                        "bead_id": root,
                        "purpose": "plan_review_completion",
                        "perspective": perspective,
                        "task_id": thread,
                        "turn_id": reminder_turn.get("id"),
                        "operation_id": reminder.get("operation_id"),
                        "input": reminder_result,
                    }
                )
                driver.task_wait(thread, 180)
                driver.role_output("weaver", thread)
    shown = driver.poll(
        "both independent plan review results",
        lambda: driver.plan(root, record_result=False),
        lambda value: all(
            value.get("reviews", {}).get(name, {}).get("state") == "completed"
            for name in ("cold_reader", "requirements")
        ),
        180,
    )
    reviews = shown["reviews"]
    resolutions = {
        str(row["review_operation"]): (
            "The fixed synthetic scope is bounded to the toy library; every concrete "
            "finding was checked against the retained draft and accepted for this run."
        )
        for row in reviews.values()
    }
    approval = driver.fc(
        "plan",
        "approve",
        "--bead",
        root,
        payload={
            "reason": "The fixed toy scope contains exactly the expected bounded deliverables.",
            "resolutions": resolutions,
            "waivers": [],
        },
    )
    approved = driver.nested(approval)
    scope = approved["approved_scope"]
    publication = driver.fc(
        "plan",
        "publish",
        "--bead",
        root,
        payload={
            "approval_operation": approved["approval_operation"],
            "approved_by": approved["approved_by"],
            "approval_evidence": approved["approval_evidence"],
            "activation": activation,
            "text": scope["draft"]["text"],
            "reviews": scope["reviews"],
            "tasks": scope["draft"]["tasks"],
            "publication": scope["draft"]["publication"],
        },
    )
    return driver.nested(publication)


def human_publish_small_future(driver: Driver) -> tuple[str, str]:
    root = driver.work_create(
        "Deferred covered check",
        "Create one small future plan whose check is already covered.",
        ["No validation child is created.", "Activation requires explicit authority."],
        "weaver",
    )
    draft = draft_payload(future=True)
    driver.fc("plan", "draft", "--bead", root, payload=draft)
    approval = driver.fc(
        "plan",
        "approve",
        "--bead",
        root,
        payload={
            "reason": "The small synthetic plan is exact and intentionally proportionate.",
            "resolutions": {},
            "waivers": [
                {"perspective": "cold_reader", "reason": "One obvious covered check."},
                {
                    "perspective": "requirements",
                    "reason": "Exact fixed synthetic request.",
                },
            ],
        },
    )
    approved = driver.nested(approval)
    scope = approved["approved_scope"]
    published = driver.fc(
        "plan",
        "publish",
        "--bead",
        root,
        payload={
            "approval_operation": approved["approval_operation"],
            "approved_by": approved["approved_by"],
            "approval_evidence": approved["approval_evidence"],
            "activation": "future",
            "text": scope["draft"]["text"],
            "reviews": scope["reviews"],
            "tasks": scope["draft"]["tasks"],
            "publication": None,
        },
    )
    child = str(next(iter(driver.nested(published)["children_by_key"].values())))
    return root, child


def wait_decision(
    driver: Driver, envelope: dict[str, Any], role_entry: dict[str, Any] | None = None
) -> dict[str, Any]:
    result = driver.nested(envelope)
    operation = str(envelope.get("operation_id"))
    turn = result.get("turn") or {}
    thread = None
    if isinstance(turn, dict):
        thread = turn.get("thread_id")
    if not thread and role_entry:
        thread = role_entry.get("thread_id")
    if thread:
        driver.roles["marshal"].append(
            {
                "bead_id": (result.get("selected_ids") or [None])[0],
                "task_id": thread,
                "turn_id": turn.get("id") if isinstance(turn, dict) else None,
                "operation_id": operation,
                "input": result.get("brief"),
            }
        )
        driver.task_wait(str(thread), 240)
        driver.role_output("marshal", str(thread))
    observed = driver.poll(
        f"Marshal decision {operation}",
        lambda: dict(
            driver.fc("operation", "show", operation, record_result=False).get("result")
            or {}
        ),
        lambda row: row.get("state") == "completed",
        180,
    )
    return observed


def dispatch_and_deliver(driver: Driver, bead: str) -> dict[str, Any]:
    workspace = driver.nested(
        driver.fc("worktree", "prepare", "--bead", bead, timeout=120)
    )
    driver.check(
        bool(workspace.get("workspace", {}).get("path")),
        f"{bead} has an isolated prepared workspace",
        workspace,
    )
    request = driver.fc("marshal", "request", "--kind", "dispatch", "--bead", bead)
    decision = wait_decision(driver, request)
    driver.check(
        any(
            row.get("action") == "dispatch" and row.get("applied")
            for row in (decision.get("result") or {}).get("rows", [])
        ),
        f"Marshal authorizes dispatch for {bead}",
        decision,
    )
    executor_work = driver.wait_role(bead, "executor", 240)
    executor = str(executor_work["fc"]["owner"])
    executor_task = driver.fc("task", "show", executor).get("result") or {}
    executor_turn = (executor_task.get("native") or {}).get("active_turn")
    driver.roles["executor"].append(
        {
            "bead_id": bead,
            "task_id": executor,
            "turn_id": executor_turn,
            "operation_id": executor_work["fc"].get("ownership_operation"),
            "input": executor_work.get("native", {}).get("description"),
        }
    )
    driver.task_wait(executor, 360)
    driver.role_output("executor", executor)
    warden_work = driver.wait_role(bead, "warden", 240)
    warden = str(warden_work["fc"]["owner"])
    warden_task = driver.fc("task", "show", warden).get("result") or {}
    driver.roles["warden"].append(
        {
            "bead_id": bead,
            "task_id": warden,
            "turn_id": (warden_task.get("native") or {}).get("active_turn"),
            "operation_id": warden_work["fc"].get("ownership_operation"),
            "input": warden_work.get("native", {}).get("description"),
        }
    )
    driver.task_wait(warden, 360)
    driver.role_output("warden", warden)
    closed = driver.wait_closed(bead, 600)
    driver.role_output("warden", warden)
    driver.check(closed.get("phase") == "done", f"{bead} reaches done", closed)
    return closed


def run(driver: Driver) -> None:
    driver.check(
        driver.report.get("source_status") == "",
        "live validation runs from a clean committed source state",
        driver.report.get("source_status"),
    )
    driver.create_fixture()
    fixture = driver.fc("fixture", "show", driver.fixture_id or "", offline=True)
    provider = fixture.get("result", {}).get("provider", {})
    models = provider.get("runtime", {}).get("capabilities", {}).get("models", {})
    driver.check(
        "low" in models.get("gpt-5.6-luna", []), "Luna/low is advertised", models
    )
    driver.check(
        provider.get("delivery", {}).get("repository_present") is True,
        "real Tollgate repository is enrolled",
        provider.get("delivery"),
    )
    driver.check(
        driver.fixture.get("provider_ownership")
        == {"runtime_project": "created", "delivery_repository": "created"},
        "fixture owns exact provider registrations",
        driver.fixture.get("provider_ownership"),
    )
    driver.start_service()

    vizier_bead = driver.work_create(
        "Curate live fixture policy",
        (
            "Explicit human request: use policy set to change only policy.rationale to "
            "'Live Luna validation policy evidence.' while retaining both capacities at 4. "
            "Then use memory set with id fc-live-ordering-memory, scope global, title "
            "'Ordering delivery preference', text 'For ordering work, preserve duplicates, "
            "require source synchronization, and order dependent tests after the library.', "
            "and references ['live-validation']. Verify both through Fulcrum reads and finish completed."
        ),
        ["YAML records the requested rationale.", "The global memory is readable."],
        "vizier",
    )
    vizier = driver.enter(
        "vizier", vizier_bead, str(driver.work(vizier_bead)["fc"]["outcome"])
    )
    driver.task_wait(str(vizier["thread_id"]), 300)
    driver.role_output("vizier", str(vizier["thread_id"]))
    vizier_closed = driver.wait_closed(vizier_bead, 180)
    policy = driver.fc("policy", "show").get("result", {}).get("policy", {})
    memory = driver.fc("memory", "show", "fc-live-ordering-memory").get("result")
    driver.check(
        policy.get("rationale") == "Live Luna validation policy evidence.",
        "Vizier changed authoritative policy",
        policy,
    )
    driver.check(
        isinstance(memory, dict) and "preserve duplicates" in str(memory.get("text")),
        "Vizier curated durable memory",
        memory,
    )
    driver.check(
        vizier_closed.get("status") == "closed", "Vizier request closes", vizier_closed
    )

    driver.fc(
        "policy",
        "set",
        payload={
            "automatic_capacity": 4,
            "default_project_capacity": 4,
            "project_capacity": {"fixture": 4},
            "paused_projects": ["fixture"],
            "rationale": "Pause automatic fixture starts during explicit Weaver validation.",
        },
    )
    paused = driver.fc("policy", "show").get("result", {}).get("policy", {})
    driver.check(
        "fixture" in paused.get("paused_projects", []),
        "automatic fixture starts pause for explicit Weaver entry",
        paused,
    )

    plan_root = driver.work_create(
        "Plan ordered aggregation",
        (
            "Draft exactly the supplied two-deliverable ordered aggregation plan. Use plan draft "
            f"with this JSON: {json.dumps(draft_payload())}. Then finish ready with a concise summary. "
            "Do not edit source and do not approve the plan."
        ),
        [
            "Exactly two ordered deliverables are retained.",
            "Independent reviews can inspect the draft.",
        ],
        "weaver",
    )
    weaver = driver.enter(
        "weaver", plan_root, str(driver.work(plan_root)["fc"]["outcome"])
    )
    driver.task_wait(str(weaver["thread_id"]), 300)
    driver.role_output("weaver", str(weaver["thread_id"]))
    planned = driver.plan(plan_root)
    draft = planned.get("draft")
    driver.check(
        isinstance(draft, dict) and len(draft.get("tasks", [])) == 2,
        "Weaver retains exactly two concrete deliverables",
        draft,
    )
    driver.fc(
        "policy",
        "set",
        payload={
            "automatic_capacity": 4,
            "default_project_capacity": 4,
            "project_capacity": {"fixture": 4},
            "paused_projects": [],
            "rationale": "Resume automatic fixture starts after explicit Weaver validation.",
        },
    )
    resumed = driver.fc("policy", "show").get("result", {}).get("policy", {})
    driver.check(
        "fixture" not in resumed.get("paused_projects", []),
        "automatic fixture starts resume after explicit Weaver entry",
        resumed,
    )
    published = publish_plan(driver, plan_root, draft_payload(), activation="active")
    children = published["children_by_key"]
    library = str(children["library"])
    edge_tests = str(children["edge-tests"])
    driver.ids["main_plan"] = {"root": plan_root, "children": children}

    uncertain = driver.work_create(
        "Clarify aggregation uniqueness",
        "Decide whether a related aggregation API should remove duplicates.",
        ["Duplicate semantics are explicitly resolved before implementation."],
        "executor",
        dependencies=[library],
        overlap_tags=["ordering"],
        intake={
            "benefit": "Keep related aggregation behavior consistent.",
            "uncertainties": [
                "The requester did not say whether duplicates are preserved."
            ],
        },
    )
    grooming = driver.fc("marshal", "request", "--kind", "groom", "--bead", uncertain)
    groom_decision = wait_decision(driver, grooming)
    groom_rows = (groom_decision.get("result") or {}).get("rows", [])
    driver.check(
        any(
            row.get("action") in {"clarify", "defer"} and row.get("applied")
            for row in groom_rows
        ),
        "Marshal preserves the material uncertainty",
        groom_rows,
    )

    library_closed = dispatch_and_deliver(driver, library)
    edge_closed = dispatch_and_deliver(driver, edge_tests)
    main_complete = driver.fc("plan", "complete", plan_root)
    main_result = driver.nested(main_complete)
    if not main_result.get("root_closed"):
        main_result = driver.nested(driver.fc("plan", "complete", plan_root))
    driver.check(
        main_result.get("root_closed") is True, "main plan root closes", main_result
    )

    remote_head = driver.git(
        driver.fixture["source_remote"], "rev-parse", "refs/heads/main"
    )
    delivery = edge_closed.get("delivery", {})
    delivered_oid = delivery.get("promotion", {}).get("integration_oid")
    if not delivered_oid:
        delivered_oid = delivery.get("synchronization", {}).get("integration_oid")
    driver.check(
        bool(remote_head), "source remote has delivered main head", remote_head
    )
    driver.check(
        isinstance(delivered_oid, str)
        and driver.git_is_ancestor(
            driver.fixture["source_remote"],
            delivered_oid,
            "refs/heads/main",
        ),
        "configured source remote contains promoted integration ancestry",
        {"remote_head": remote_head, "promoted_integration_oid": delivered_oid},
    )
    remote_ordering = driver.git(
        driver.fixture["source_remote"], "show", f"{remote_head}:ordering.py"
    )
    driver.check(
        "def aggregate_ordered" in remote_ordering,
        "fixture integration content is present in the source remote",
        {"remote_head": remote_head, "ordering.py": remote_ordering},
    )
    driver.ids["delivery"] = {
        "library": library_closed,
        "edge_tests": edge_closed,
        "remote_head": remote_head,
        "reported_source": delivered_oid,
    }

    driver.fc(
        "policy",
        "set",
        payload={
            "automatic_capacity": 4,
            "default_project_capacity": 4,
            "project_capacity": {"fixture": 4},
            "rationale": "Explicit disposable fixture capacity.",
        },
    )
    dispatch_inputs = [
        item.get("input")
        for item in driver.roles["marshal"]
        if isinstance(item.get("input"), dict)
    ]
    driver.check(
        any("fc-live-ordering-memory" in json.dumps(item) for item in dispatch_inputs),
        "subsequent Marshal decision receives Vizier memory",
        dispatch_inputs,
    )

    future_root, future_child = human_publish_small_future(driver)
    driver.ids["future_plan"] = {"root": future_root, "child": future_child}
    before_activation_tasks = (
        driver.fc("task", "list", "--limit", "0").get("result", {}).get("items", [])
    )
    driver.check(
        not any(
            future_child == item.get("work_bead") for item in before_activation_tasks
        ),
        "future child does not start from timer or capacity",
        before_activation_tasks,
    )
    future_plan = driver.plan(future_root)
    driver.check(
        len(future_plan.get("children", [])) == 1,
        "small plan has no default validation child",
        future_plan,
    )

    restart = driver.fc("service", "restart", offline=True, timeout=120)
    driver.check(
        restart.get("ok") is True, "controller restarts with retained work", restart
    )
    retained_context = driver.fc("context", "--bead", future_root).get("result")
    driver.check(
        retained_context.get("work", {}).get("id") == future_root,
        "ownership and context survive controller restart",
        retained_context,
    )
    authorization = driver.nested(driver.fc("plan", "activate", future_root))[
        "activation_authorization"
    ]["operation_id"]
    activated = driver.nested(
        driver.fc("plan", "activate", future_root, "--authorization", authorization)
    )
    driver.check(
        activated.get("activation") == "active",
        "future plan activates explicitly",
        activated,
    )
    driver.fc(
        "work",
        "close",
        future_child,
        "--outcome",
        "answered",
        "--summary",
        "Existing ordering unit test supplies the declared check.",
    )
    driver.check(
        driver.nested(driver.fc("plan", "complete", future_root)).get("root_closed")
        is True,
        "activated small plan closes from existing evidence",
        future_root,
    )

    sage = driver.enter(
        "sage",
        edge_tests,
        (
            "Inspect this delivered bead using trace, task output, promotion show, and cost. "
            "Identify one concrete workflow evidence gap actually present (for example partial "
            "cost coverage), then finish findings with one report object containing exactly title, "
            "problem, observed_evidence, required_change, and acceptance_checks. Do not edit source."
        ),
    )
    driver.task_wait(str(sage["thread_id"]), 300)
    driver.role_output("sage", str(sage["thread_id"]))
    sage_closed = driver.wait_closed(edge_tests, 180)
    sage_investigations = sage_closed.get("fc", {}).get("investigations", [])
    driver.check(
        bool(sage_investigations), "Sage retains concrete findings", sage_investigations
    )
    driver.check(
        sage_closed.get("id") == edge_tests
        and sage_closed.get("fc", {}).get("disposition", {}).get("outcome")
        == "delivered",
        "Sage preserves delivered identity and disposition",
        sage_closed,
    )

    mason_bead = driver.work_create(
        "Inspect duplicated ordering components",
        "Inspect ordering.py and legacy_ordering.py for actual duplicated responsibility and report one bounded finding.",
        ["A concrete duplicated component is cited.", "A report bead is retained."],
        "mason",
    )
    mason = driver.enter(
        "mason", mason_bead, str(driver.work(mason_bead)["fc"]["outcome"])
    )
    driver.task_wait(str(mason["thread_id"]), 300)
    driver.role_output("mason", str(mason["thread_id"]))
    mason_closed = driver.wait_closed(mason_bead, 180)
    mason_investigations = mason_closed.get("fc", {}).get("investigations", [])
    driver.check(
        bool(mason_investigations),
        "Mason retains concrete findings",
        mason_investigations,
    )

    report_beads: list[str] = []
    for investigation in [*sage_investigations, *mason_investigations]:
        report_beads.extend(
            str(item) for item in investigation.get("reports", []) if item
        )
    driver.check(
        len(report_beads) >= 2, "specialists file actual report beads", report_beads
    )
    for report_bead in report_beads:
        driver.fc(
            "work",
            "close",
            report_bead,
            "--outcome",
            "cancelled",
            "--summary",
            "Follow-up retained as live evidence and explicitly bounded to this disposable fixture.",
        )

    blocked = driver.work_create(
        "Resolve optional impossible delivery check",
        (
            "This synthetic delivery has a satisfied core ordering check and an optional criterion "
            "requiring contact with nonexistent.invalid. Do not fabricate contact. Finish blocked "
            "and request a scoped decision about waiving only that optional criterion."
        ),
        [
            "Core ordering tests remain satisfied.",
            "Optional external contact is either observed or explicitly waived.",
        ],
        "executor",
    )
    blocked_executor = driver.enter(
        "executor", blocked, str(driver.work(blocked)["fc"]["outcome"])
    )
    driver.task_wait(str(blocked_executor["thread_id"]), 240)
    driver.role_output("executor", str(blocked_executor["thread_id"]))
    driver.poll(
        "synthetic blocked transfer",
        lambda: driver.work(blocked, record_result=False),
        lambda row: row.get("status") == "blocked"
        or row.get("phase") in {"backlog", "human"},
        180,
    )
    inspection = driver.fc("recover", "inspect", "--scope", f"bead:{blocked}")
    takeover = driver.fc(
        "recover",
        "takeover",
        "--scope",
        f"bead:{blocked}",
        "--reason",
        "Waive only the explicitly optional infeasible synthetic criterion.",
    )
    driver.check(
        driver.nested(takeover).get("fence", {}).get("state") == "active",
        "scoped recovery fence is active",
        takeover,
    )
    justiciar = driver.enter(
        "justiciar",
        blocked,
        (
            "Inspect the active bead-scoped recovery and the actual blocked evidence. Do not "
            "contact the infeasible optional endpoint and do not waive the core ordering check. "
            "Finish repaired with changes describing the scoped decision, waived_requirements "
            "containing only the optional external contact, known_defects empty, evidence citing "
            "the recovery inspection, and no source_oid."
        ),
    )
    driver.task_wait(str(justiciar["thread_id"]), 300)
    driver.role_output("justiciar", str(justiciar["thread_id"]))
    repaired = driver.wait_closed(blocked, 180)
    disposition = repaired.get("fc", {}).get("disposition", {})
    driver.check(
        disposition.get("outcome") == "repaired"
        and len(disposition.get("waived_requirements", [])) == 1,
        "Justiciar records the scoped tradeoff truthfully",
        disposition,
    )
    driver.fc(
        "recover",
        "release",
        "--scope",
        f"bead:{blocked}",
        "--summary",
        "The optional criterion waiver and residual truth are retained.",
    )
    driver.ids["recovery"] = {
        "bead": blocked,
        "inspection": inspection.get("result"),
        "takeover_operation": takeover.get("operation_id"),
    }

    stale = driver.fc(
        "finish",
        "--bead",
        library,
        "--outcome",
        "ready_for_review",
        "--thread-id",
        str(driver.roles["executor"][0]["task_id"]),
        "--ownership-operation",
        str(driver.roles["executor"][0]["operation_id"]),
        payload={
            "summary": "Stale writer attempt.",
            "source_oid": remote_head,
            "checks": [{"name": "stale", "status": "passed", "evidence": "none"}],
            "evidence": ["stale-attempt"],
        },
        expected=(5,),
        actor=f"task:{driver.roles['executor'][0]['task_id']}",
    )
    driver.check(
        stale.get("error", {}).get("code") in {"OWNERSHIP_CONFLICT", "FINISH_SEALED"},
        "stale owner cannot write after handoff",
        stale.get("error"),
    )

    observability = {
        "status": driver.fc("status").get("result"),
        "context": driver.fc("context", "--bead", blocked).get("result"),
        "requests": driver.fc("task", "requests", str(justiciar["thread_id"])).get(
            "result"
        ),
        "trace": driver.fc("trace", "--bead", library, "--limit", "0").get("result"),
        "delivery": driver.fc("promotion", "show", "--bead", library).get("result"),
        "usage": driver.fc("usage", "--bead", plan_root).get("result"),
        "vizier_usage": driver.fc("usage", "--role", "vizier").get("result"),
        "cost": driver.fc("cost", "--bead", plan_root).get("result"),
        "doctor": driver.fc("doctor").get("result"),
    }
    driver.report["observability"] = observability
    capacity = observability["status"].get("capacity", {})
    driver.check(
        capacity.get("global_limit") == 4
        and capacity.get("default_project_limit") == 4,
        "default native capacity remains four",
        capacity,
    )
    driver.check(
        bool(observability["trace"].get("items")),
        "trace exposes durable workflow links",
        observability["trace"],
    )
    driver.check(
        observability["delivery"].get("delivery", {}).get("promotion") == "promoted",
        "delivery observation records real promotion",
        observability["delivery"],
    )
    driver.check(
        observability["cost"].get("coverage") in {"complete", "partial", "unknown"},
        "completion cost reports explicit coverage",
        observability["cost"],
    )

    vizier_output = driver.roles["vizier"][0].get("output") or {}
    driver.check(
        len(driver.roles["vizier"]) == 1
        and len(observability["vizier_usage"].get("included_native_turn_ids", [])) == 1,
        "Vizier received no automatic request turns",
        {
            "captured_turns": driver.roles["vizier"],
            "usage": observability["vizier_usage"],
            "output": vizier_output,
        },
    )
    driver.report["native_turn_start_counts"] = {
        role: len({row.get("turn_id") for row in rows if row.get("turn_id")})
        for role, rows in driver.roles.items()
    }
    for role, rows in driver.roles.items():
        driver.check(bool(rows), f"native evidence exists for {role}", rows)
        for row in rows:
            driver.check(
                bool(row.get("task_id")) and bool(row.get("operation_id")),
                f"{role} evidence links task and operation IDs",
                row,
            )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--executable",
        default=str(Path(sys.executable).with_name("fulcrum")),
    )
    parser.add_argument("--runtime-endpoint", default="ws://127.0.0.1:4500")
    parser.add_argument("--codex-executable", default=shutil.which("codex"))
    parser.add_argument("--tollgate-executable", default=shutil.which("tg"))
    parser.add_argument("--timeout", type=float, default=3000)
    parser.add_argument("--command-timeout", type=float, default=60)
    parser.add_argument("--fixture-parent", default="/tmp")
    parser.add_argument(
        "--report",
        default=f"/tmp/fulcrum2-live-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}.json",
    )
    arguments = parser.parse_args()
    if arguments.timeout > 3000 or arguments.timeout <= 120:
        parser.error("--timeout must be greater than 120 and at most 3000 seconds")
    if not arguments.codex_executable or not arguments.tollgate_executable:
        parser.error("native Codex and Tollgate executables are required")
    return arguments


def main() -> int:
    arguments = parse_args()
    driver = Driver(arguments)
    try:
        run(driver)
        driver.report["state"] = "passed"
    except Exception as error:
        driver.report["state"] = "failed"
        driver.report["error"] = {"type": type(error).__name__, "message": str(error)}
    finally:
        driver.save()
        driver.cleanup_fixture()
        if not driver.cleanup or driver.cleanup.get("root_removed") is not True:
            driver.report["state"] = "failed"
        driver.report["finished_at"] = now()
        driver.save()
        driver.save_markdown()
        try:
            if driver.fixture_parent.exists() and not any(
                driver.fixture_parent.iterdir()
            ):
                driver.fixture_parent.rmdir()
        except OSError:
            pass
    print(
        json.dumps(
            {
                "state": driver.report["state"],
                "report": str(driver.report_path),
                "markdown": str(driver.markdown_path),
            }
        )
    )
    return 0 if driver.report["state"] == "passed" else 1


if __name__ == "__main__":
    raise SystemExit(main())

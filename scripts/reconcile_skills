#!/usr/bin/env python3.12
"""Repair Codex skill links without running the full Fulcrum setup."""

from __future__ import annotations

import sys
from pathlib import Path


SOURCE_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(SOURCE_ROOT / "src"))

from fulcrum.install import InstallationError, reconcile_skill_links  # noqa: E402


def main() -> int:
    try:
        installed = reconcile_skill_links(SOURCE_ROOT)
    except InstallationError as error:
        print(f"fulcrum skill reconciliation failed: {error}", file=sys.stderr)
        return 2

    for target in installed:
        print(f"linked {target}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fulcrum.local/schemas/records-v1.schema.json",
  "title": "Fulcrum local coordination records, version 1",
  "oneOf": [
    { "$ref": "#/$defs/installation" },
    { "$ref": "#/$defs/project_registry" },
    { "$ref": "#/$defs/role_run_registry" },
    { "$ref": "#/$defs/holds_jobs" },
    { "$ref": "#/$defs/assignment" },
    { "$ref": "#/$defs/progress" },
    { "$ref": "#/$defs/executor_evidence" },
    { "$ref": "#/$defs/interview" }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "base": {
      "type": "object",
      "required": ["record_kind", "schema_version", "writer_id", "updated_at"],
      "properties": {
        "record_kind": { "type": "string" },
        "schema_version": { "const": 1 },
        "writer_id": { "type": "string", "minLength": 1 },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "recovery_attempt": {
      "type": "object",
      "required": ["at", "hypothesis", "action", "outcome", "evidence"],
      "properties": {
        "at": { "$ref": "#/$defs/timestamp" },
        "hypothesis": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "failure_event": {
      "type": "object",
      "required": ["boundary", "occurred_at", "evidence", "unchanged_retry_used", "diagnosis_deadline"],
      "properties": {
        "boundary": { "type": "string", "minLength": 1 },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "evidence": { "type": "string", "minLength": 1 },
        "unchanged_retry_used": { "type": "boolean" },
        "diagnosis_deadline": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "escalation": {
      "type": "object",
      "required": ["boundary", "error", "evidence", "attempts", "retained_work", "untried_recovery", "requested_decision", "expected_next_actor"],
      "properties": {
        "boundary": { "type": "string", "minLength": 1 },
        "error": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/recovery_attempt" } },
        "retained_work": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "untried_recovery": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "requested_decision": { "type": "string", "minLength": 1 },
        "expected_next_actor": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "emergency_authorization": {
      "type": "object",
      "required": ["outage_evidence", "attempted_recovery", "scope", "repair_owner", "permitted_runtime_changes", "certified_release_oid", "provisional"],
      "properties": {
        "outage_evidence": { "type": "string", "minLength": 1 },
        "attempted_recovery": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "scope": { "type": "string", "minLength": 1 },
        "repair_owner": { "type": "string", "minLength": 1 },
        "permitted_runtime_changes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "certified_release_oid": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "provisional": { "const": true }
      },
      "additionalProperties": false
    },
    "installation": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["brain_root", "state_root", "host_id", "configured_services", "observations"],
          "properties": {
            "record_kind": { "const": "installation" },
            "schema_version": { "const": 1 },
            "writer_id": { "type": "string", "minLength": 1 },
            "updated_at": { "$ref": "#/$defs/timestamp" },
            "brain_root": { "type": "string", "minLength": 1 },
            "state_root": { "type": "string", "minLength": 1 },
            "host_id": { "type": "string", "minLength": 1 },
            "configured_services": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["beads", "codex", "dashboard", "hooks", "tollgate"] }
            },
            "observations": {
              "type": "object",
              "additionalProperties": { "enum": ["available", "unavailable", "unverified"] }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "project_registry": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["projects"],
          "properties": {
            "record_kind": { "const": "project_registry" },
            "schema_version": { "const": 1 },
            "writer_id": { "type": "string", "minLength": 1 },
            "updated_at": { "$ref": "#/$defs/timestamp" },
            "projects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["project_id", "repo_path", "host_id", "codex_project_id", "tollgate_repo_id", "enabled"],
                "properties": {
                  "project_id": { "type": "string", "minLength": 1 },
                  "repo_path": { "type": "string", "minLength": 1 },
                  "host_id": { "type": "string", "minLength": 1 },
                  "codex_project_id": { "type": ["string", "null"], "minLength": 1 },
                  "tollgate_repo_id": { "type": ["string", "null"], "minLength": 1 },
                  "enabled": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "role_run_registry": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["current_archon_task_id", "roles"],
          "properties": {
            "record_kind": { "const": "role_run_registry" },
            "schema_version": { "const": 1 },
            "writer_id": { "type": "string", "minLength": 1 },
            "updated_at": { "$ref": "#/$defs/timestamp" },
            "current_archon_task_id": { "type": ["string", "null"], "minLength": 1 },
            "roles": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["role", "project_id", "host_id", "task_id", "identity_state", "role_number", "run_id", "pair_id", "title", "selected_model", "selected_reasoning", "model_authorization", "skill_revision"],
                "properties": {
                  "role": { "enum": ["archon", "executor", "inquisitor", "night_watchman", "overseer", "sage", "weaver"] },
                  "project_id": { "type": "string", "minLength": 1 },
                  "host_id": { "type": "string", "minLength": 1 },
                  "task_id": { "type": ["string", "null"], "minLength": 1 },
                  "client_thread_id": { "type": "string", "minLength": 1 },
                  "identity_state": { "enum": ["resolved", "pending", "unavailable"] },
                  "role_number": { "type": ["integer", "null"], "minimum": 1 },
                  "run_id": { "type": "string", "minLength": 1 },
                  "pair_id": { "type": ["string", "null"], "minLength": 1 },
                  "title": { "type": "string", "minLength": 1 },
                  "selected_model": { "type": "string", "minLength": 1 },
                  "selected_reasoning": { "type": "string", "minLength": 1 },
                  "model_authorization": {
                    "type": "object",
                    "required": ["source", "reference"],
                    "properties": {
                      "source": { "enum": ["human", "plan", "default"] },
                      "reference": { "type": ["string", "null"], "minLength": 1 }
                    },
                    "additionalProperties": false
                  },
                  "agent_recommendation": { "type": ["string", "null"], "minLength": 1 },
                  "skill_revision": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "holds_jobs": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["holds", "recurring_jobs"],
          "properties": {
            "record_kind": { "const": "holds_jobs" },
            "schema_version": { "const": 1 },
            "writer_id": { "type": "string", "minLength": 1 },
            "updated_at": { "$ref": "#/$defs/timestamp" },
            "holds": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["hold_id", "scope", "reason", "release_condition", "permitted_exceptions"],
                "properties": {
                  "hold_id": { "type": "string", "minLength": 1 },
                  "scope": { "type": "string", "pattern": "^(fleet|host:[A-Za-z0-9._-]+|project:[A-Za-z0-9._-]+|plan:[A-Za-z0-9._-]+|assignment:[A-Za-z0-9._-]+)$" },
                  "reason": { "type": "string", "minLength": 1 },
                  "release_condition": { "type": "string", "minLength": 1 },
                  "permitted_exceptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "owner_id": { "type": "string", "minLength": 1 },
                  "release_mode": { "enum": ["human", "evidence"] },
                  "exceptions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["recovery_scope", "permitted_resources"],
                      "properties": {
                        "recovery_scope": { "type": "string", "minLength": 1 },
                        "permitted_resources": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
                      },
                      "additionalProperties": false
                    }
                  },
                  "released_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
                  "released_by": { "type": ["string", "null"], "minLength": 1 },
                  "release_evidence": { "type": ["string", "null"], "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "recurring_jobs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["job_id", "cadence_anchor", "next_due", "active_run_id"],
                "properties": {
                  "job_id": { "type": "string", "minLength": 1 },
                  "cadence_anchor": { "$ref": "#/$defs/timestamp" },
                  "next_due": { "$ref": "#/$defs/timestamp" },
                  "active_run_id": { "type": ["string", "null"], "minLength": 1 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "assignment": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["assignment_id", "bead_id", "plan_id", "approved_plan_commit", "executor_task_id", "overseer_task_id", "scope_reference", "review_history", "mandate"],
          "properties": {
            "record_kind": { "const": "assignment" },
            "schema_version": { "const": 1 },
            "writer_id": { "type": "string", "minLength": 1 },
            "updated_at": { "$ref": "#/$defs/timestamp" },
            "assignment_id": { "type": "string", "minLength": 1 },
            "bead_id": { "type": "string", "minLength": 1 },
            "plan_id": { "type": ["string", "null"], "minLength": 1 },
            "approved_plan_commit": { "type": ["string", "null"], "minLength": 7 },
            "executor_task_id": { "type": "string", "minLength": 1 },
            "overseer_task_id": { "type": "string", "minLength": 1 },
            "scope_reference": { "type": "string", "minLength": 1 },
            "review_history": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["attempt", "outcome", "candidate_id", "at", "notes"],
                "properties": {
                  "attempt": { "type": "integer", "minimum": 1 },
                  "source_oid": { "type": "string", "minLength": 7 },
                  "outcome": { "enum": ["approved", "changes_requested", "escalated"] },
                  "candidate_id": { "type": "string", "minLength": 1 },
                  "at": { "$ref": "#/$defs/timestamp" },
                  "notes": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "mandate": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["candidate_id", "scope", "granted_at"],
                  "properties": {
                    "candidate_id": { "type": "string", "minLength": 1 },
                    "scope": { "type": "string", "minLength": 1 },
                    "granted_at": { "$ref": "#/$defs/timestamp" },
                    "allowed_replacements": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                    "replaces_candidate_id": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "progress": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["role_task_id", "role", "phase", "phase_started_at", "expected_next_actor", "expected_next_action", "handoff_needed", "handoff_sent", "delivery_error", "owned_resources"],
          "properties": {
            "record_kind": { "const": "progress" },
            "schema_version": { "const": 1 },
            "writer_id": { "type": "string", "minLength": 1 },
            "updated_at": { "$ref": "#/$defs/timestamp" },
            "role_task_id": { "type": "string", "minLength": 1 },
            "role": { "enum": ["archon", "executor", "inquisitor", "night_watchman", "overseer", "sage", "weaver"] },
            "phase": { "enum": ["queued", "implementing", "reviewing", "fixing", "promoting", "investigating", "paused", "completed", "canceled"] },
            "phase_started_at": { "$ref": "#/$defs/timestamp" },
            "expected_next_actor": { "type": ["string", "null"], "minLength": 1 },
            "expected_next_action": { "type": "string", "minLength": 1 },
            "handoff_needed": { "type": "boolean" },
            "handoff_sent": { "type": "boolean" },
            "delivery_error": { "type": ["string", "null"], "minLength": 1 },
            "owned_resources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["kind", "identifier"],
                "properties": {
                  "kind": { "type": "string", "minLength": 1 },
                  "identifier": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "push_obligations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["source", "command", "detail"],
                "properties": {
                  "source": { "enum": ["git", "beads"] },
                  "command": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "detail": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "escalation": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/escalation" }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "executor_evidence": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["executor_task_id", "worktree_path", "base_oid", "source_oid", "candidate_id", "tested_oid", "queue_revision", "push_state", "cleanup_state", "suspended_investigations"],
          "properties": {
            "record_kind": { "const": "executor_evidence" },
            "schema_version": { "const": 1 },
            "writer_id": { "type": "string", "minLength": 1 },
            "updated_at": { "$ref": "#/$defs/timestamp" },
            "executor_task_id": { "type": "string", "minLength": 1 },
            "worktree_path": { "type": "string", "minLength": 1 },
            "base_oid": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
            "source_oid": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
            "candidate_id": { "type": "string", "minLength": 1 },
            "tested_oid": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$" },
            "queue_revision": { "type": "integer", "minimum": 0 },
            "push_state": { "enum": ["not_required", "pending", "complete", "failed"] },
            "cleanup_state": { "enum": ["not_eligible", "pending", "complete", "failed"] },
            "suspended_investigations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["task_id", "reason", "evidence_reference"],
                "properties": {
                  "task_id": { "type": "string", "minLength": 1 },
                  "reason": { "type": "string", "minLength": 1 },
                  "evidence_reference": { "type": "string", "minLength": 1 },
                  "project_id": { "type": "string", "minLength": 1 },
                  "worktree_path": { "type": "string", "minLength": 1 },
                  "source_oid": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$" },
                  "candidate_id": { "type": ["string", "null"], "minLength": 1 },
                  "review_history": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["attempt", "outcome", "candidate_id", "at", "notes"],
                      "properties": {
                        "source_oid": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
                        "attempt": { "type": "integer", "minimum": 1 },
                        "outcome": { "enum": ["approved", "changes_requested", "escalated"] },
                        "candidate_id": { "type": "string", "minLength": 1 },
                        "at": { "$ref": "#/$defs/timestamp" },
                        "notes": { "type": "string", "minLength": 1 }
                      },
                      "additionalProperties": false
                    }
                  },
                  "failure_history": { "type": "array", "items": { "$ref": "#/$defs/failure_event" } }
                },
                "additionalProperties": false
              }
            },
            "failure_history": { "type": "array", "items": { "$ref": "#/$defs/failure_event" } },
            "emergency_authorization": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/emergency_authorization" }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "interview": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "required": ["sage_task_id", "run_id", "subject_task_id", "prior_archived", "reminder_state", "completion_state"],
          "properties": {
            "record_kind": { "const": "interview" },
            "schema_version": { "const": 1 },
            "writer_id": { "type": "string", "minLength": 1 },
            "updated_at": { "$ref": "#/$defs/timestamp" },
            "sage_task_id": { "type": "string", "minLength": 1 },
            "run_id": { "type": "string", "minLength": 1 },
            "subject_task_id": { "type": "string", "minLength": 1 },
            "prior_archived": { "type": "boolean" },
            "reminder_state": { "enum": ["not_due", "due", "sent", "failed"] },
            "completion_state": { "enum": ["active", "complete", "canceled"] }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
